show "[09/19] dictionary structures and inherited methods" = debug:workspace:print

struct Example = [
    bytes = hex { c3 }
    method = asm { ret }
    nested = [ ping = <debug:ping> ]
]

let example = <Example>
struct ExamplePointer = <Example>
let example_pointer = <ExamplePointer>

let exercise_template = {
    invoke <Example:method>
    invoke <Example:nested:ping>
}
exercise_template



show "[10/19] physical records, arrays, methods and pointer depth" = debug:workspace:print

record Header(magic:u8[4], version:u16, flags:u16) packed
record Packet(header:Header, length:u32, payload:u64) align(16)
method Packet clear(self:Packet*, fill:u8) -> void abi sysv-amd64

Header header
Packet packet
pointer Packet* packet_pointer
pointer Packet** packet_pointer_pointer
pointer Packet*** packet_pointer_pointer_pointer




