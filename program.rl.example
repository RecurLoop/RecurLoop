    "hello world" = <debug:ping>
    "hello RecurLoop 🚀" = <debug:ping>
    "contains:colon" = <debug:ping>
    "${generated_suffix} command" = <debug:ping>
]

let commands:${generated_suffix}:ping = <debug:ping>
let generated_path = <commands:"${generated_suffix} command">
let generated_nested_path = <commands:${generated_suffix}:ping>

commands:ping
commands : nested : ping
commands hello world
commands hello RecurLoop 🚀
commands:contains:colon
commands runtime command
commands:runtime:ping

let quoted_ping = <commands:"hello world">
quoted_ping
generated_path
generated_nested_path



