// RecurLoop executable tour and smoke test.
//
// Run with `make showcase`. The numbered markers cover values, control flow,
// phrases, records, native functions, x86-64 assembly, ABI declarations, ELF
// linking, and exact byte output. Assertions stop at the first failed check.
// Generated artifacts are written to /tmp/recurloop-showcase*.

const decimal = 1_000
const hexadecimal = 0x2a
const binary = 0b101010
const octal = 0o52
const real_value = 1.25e2

assert hexadecimal == 42 && binary == 42 && octal == 42
assert decimal + hexadecimal * 2 == 1084
assert (decimal + hexadecimal) * 2 == 2084
assert -7 + +2 == -5
assert 17 / 5 == 3 && 17 % 5 == 2
assert real_value / 2 == 62.5
assert 9223372036854775807 > 9223372036854775806
assert type(null) == "null"
assert type(true) == "bool"
assert type(decimal) == "int"
assert type(real_value) == "real"
assert type("text") == "string"

assert false && missing_function() || true
assert true || 1 / 0 == 0

print "[01/19] values and arithmetic: ok"



const padded = "  hello RecurLoop  "
const clean = trim(padded)
const loud = upper(clean)
const quiet = lower(loud)

assert clean == "hello RecurLoop"
assert loud == "HELLO RECURLOOP"
assert quiet == "hello recurloop"
assert len(clean) == 15
assert contains(clean, "Recur")
assert starts_with(clean, "hello")
assert ends_with(clean, "Loop")
assert substr(clean, 6, 5) == "Recur"
assert substr(clean, 6) == "RecurLoop"
assert replace(clean, "hello", "welcome") == "welcome RecurLoop"
assert "number=" + 42 + ", bool=" + true == "number=42, bool=true"
assert "line\nfeed" == "line\nfeed"

print "[02/19] strings: " + replace(loud, "HELLO", "WELCOME")



var accumulator = 10
accumulator += 5
accumulator -= 3
accumulator *= 4
accumulator /= 6
accumulator %= 3
assert accumulator == 2

accumulator *= 3
assert accumulator == 6

const scope_name = "outer"
if true {
    const scope_name = "inner"
    var block_only = 40
    block_only += 2
    assert scope_name == "inner" && block_only == 42
} else {
    assert false
}
assert scope_name == "outer"

print "[03/19] bindings and lexical scopes: ok"



var index = 0
var sequence = ""
while index < 5 {
    if index % 2 == 0 {
        sequence += "E" + str(index)
    } else {
        sequence += "O" + str(index)
    }
    index += 1
}
assert sequence == "E0O1E2O3E4"

if contains(sequence, "E4") {
    if !contains(sequence, "E5") {
        print "[04/19] control flow: " + sequence
    } else {
        assert false
    }
} else {
    assert false
}



print "[04.5/19] engine image export/import"

engine export "/tmp/recurloop-showcase-engine.rli"
engine import "/tmp/recurloop-showcase-engine.rli"



fn factorial(n:i64) -> i64 {
    if n <= 1 {
        return 1
    } else {
        return n * factorial(n - 1)
    }
}

assert factorial(0) == 1
assert factorial(6) == 720

let add_ten = fn (value:i64) -> i64 {
    return value + 10
}

const compile_time_value = add_ten(32)
assert compile_time_value == 42
assert add_ten(compile_time_value) == 52
assert add_ten(factorial(3)) == 16

factorial(3)

print "[05/19] functions and recursion: factorial(6)=" + factorial(6)



let show = <let>
