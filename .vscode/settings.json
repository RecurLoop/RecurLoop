{
    "editor.formatOnSave": false,
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,
    "cmake.configurePreset": "debug",
    "cmake.buildPreset": "debug",
    "clangd.arguments": [
        "--compile-commands-dir=build/Debug",
        "--clang-tidy",
        "--header-insertion=never"
    ],
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "files.associations": {
        "*.rl": "recurloop",
        "*.rl.example": "recurloop"
    },
    "[swift]": {
        "editor.semanticHighlighting.enabled": false,
        "editor.formatOnSave": false
    },
    "terminal.integrated.profiles.linux": {
        "RecurLoop": {
            "extensionIdentifier": "recurloop.recurloop-vscode",
            "id": "recurloop.console",
            "title": "RecurLoop"
        }
    },
    "terminal.integrated.defaultProfile.linux": "RecurLoop",
    // Development override: installed extensions default to recurloop on PATH.
    "recurloop.executablePath": "${workspaceFolder}/build/Release/bin/recurloop",
    "recurloop.terminal.libraries": [
        "shell",
        "inferred"
    ]
}
